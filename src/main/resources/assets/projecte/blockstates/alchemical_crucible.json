{
  "multipart": [
    {
      "apply": {
        "model": "projecte:block/alchemical_crucible"
      }
    },
    {
      "when": {
        "glow": "1"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow"
      }
    },
    {
      "when": {
        "glow": "2"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow_nigredo"
      }
    },
    {
      "when": {
        "glow": "3"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow_albedo"
      }
    },
    {
      "when": {
        "glow": "4"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow_citrinitas"
      }
    },
    {
      "when": {
        "glow": "5"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow_rubedo"
      }
    },
    {
      "when": {
        "glow": "6"
      },
      "apply": {
        "model": "projecte:block/crucible/alchemical_crucible_glow_complete"
      }
    }
  ]
}
